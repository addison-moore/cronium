{
  "name": "@cronium/info",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "clear": "rm -rf .next",
    "start": "next start",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
