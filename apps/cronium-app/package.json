{
  "name": "@cronium/app",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "dotenv -e ../../env/.env.local -- next dev -p 5001",
    "build": "dotenv -e ../../env/.env.local -- next build",
    "start": "dotenv -e ../../env/.env.local -- next start -p 5001",
    "lint": "SKIP_ENV_VALIDATION=1 next lint",
    "lint:fix": "SKIP_ENV_VALIDATION=1 next lint --fix",
    "lint:log": "SKIP_ENV_VALIDATION=1 next lint > ../../logs/lint.log 2>&1",
    "tsc:log": "tsc --noEmit > ../../logs/tsc.log 2>&1 || true",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "db:migrate": "node scripts/run-migrations.cjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "test": "jest --passWithNoTests",
    "clear": "rm -rf .next",
    "clear-logs": "tsx src/scripts/clear-all-logs.ts",
    "dev:socket": "tsx --env-file=../../env/.env.local server.ts",
    "dev:worker": "tsx --env-file=../../env/.env.local worker.ts",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/worker.cjs"
  },
