{
  "name": "@cronium/app",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "dotenv -e ../../env/.env.local -- next dev --webpack -p 5001",
    "build": "dotenv -e ../../env/.env.local -- next build --webpack",
    "start": "dotenv -e ../../env/.env.local -- next start -p 5001",
    "lint": "SKIP_ENV_VALIDATION=1 eslint .",
    "lint:fix": "SKIP_ENV_VALIDATION=1 eslint . --fix",
    "lint:log": "SKIP_ENV_VALIDATION=1 eslint . > ../../logs/lint.log 2>&1",
    "tsc:log": "tsc --noEmit > ../../logs/tsc.log 2>&1 || true",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "db:migrate": "node scripts/run-migrations.cjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "test": "jest --passWithNoTests",
    "clear": "rm -rf .next",
    "clear-logs": "tsx src/scripts/clear-all-logs.ts",
    "rotate:secrets": "tsx src/scripts/rotate-secrets.ts",
    "dev:socket": "tsx --env-file=../../env/.env.local server.ts",
    "dev:worker": "tsx --env-file=../../env/.env.local worker.ts",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --alias:@cronium/ui=./worker-stubs/ui.cjs --tsconfig=tsconfig.json --outfile=dist/worker.cjs",
    "build:socket": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/socket-server.cjs",
    "build:rotate": "esbuild src/scripts/rotate-secrets.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/rotate-secrets.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@cronium/ui": "workspace:*",
    "@google/genai": "^2.32.0",
    "@hookform/resolvers": "^7.0.2",
    "@monaco-editor/react": "^4.7.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.105.3",
    "@trpc/client": "^11.23.0",
    "@trpc/react-query": "^11.23.0",
    "@trpc/server": "^11.23.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.12.1",
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.3",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "handlebars": "^4.7.10",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.67.0",
    "monaco-editor": "^0.57.0",
    "mongodb": "^7.8.0",
    "mysql2": "^3.24.6",
    "nanoid": "^6.0.2",
    "next": "16.4.5",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "openai": "^7.49.0",
    "pg": "^8.23.1",
    "pg-cursor": "^2.22.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ssh2": "^1.17.0",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cronium/eslint-config": "workspace:*",
    "@cronium/tailwind-config": "workspace:*",
    "@cronium/typescript-config": "workspace:*",
    "@next/bundle-analyzer": "16.4.5",
    "@tailwindcss/postcss": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
