{
  "name": "@cronium/app",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "dotenv -e ../../env/.env.local -- next dev --webpack -p 5001",
    "build": "dotenv -e ../../env/.env.local -- next build --webpack",
    "start": "dotenv -e ../../env/.env.local -- next start -p 5001",
    "lint": "SKIP_ENV_VALIDATION=1 next lint",
    "lint:fix": "SKIP_ENV_VALIDATION=1 next lint --fix",
    "lint:log": "SKIP_ENV_VALIDATION=1 next lint > ../../logs/lint.log 2>&1",
    "tsc:log": "tsc --noEmit > ../../logs/tsc.log 2>&1 || true",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "db:migrate": "node scripts/run-migrations.cjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "test": "jest --passWithNoTests",
    "clear": "rm -rf .next",
    "clear-logs": "tsx src/scripts/clear-all-logs.ts",
    "rotate:secrets": "tsx src/scripts/rotate-secrets.ts",
    "dev:socket": "tsx --env-file=../../env/.env.local server.ts",
    "dev:worker": "tsx --env-file=../../env/.env.local worker.ts",
    "build:worker": "esbuild worker.ts --bundle --platform=node --format=cjs --packages=external --alias:@cronium/ui=./worker-stubs/ui.cjs --tsconfig=tsconfig.json --outfile=dist/worker.cjs",
    "build:socket": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --tsconfig=tsconfig.json --outfile=dist/socket-server.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@cronium/ui": "workspace:*",
    "@google/genai": "^2.16.0",
    "@hookform/resolvers": "^5.7.1",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/next": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
