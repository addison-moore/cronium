    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.7.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
