    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.2",
    "lucide-react": "^1.29.0",
    "monaco-editor": "^0.56.0",
    "mongodb": "^7.5.0",
    "mysql2": "^3.23.2",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "next-auth": "^4.24.15",
    "next-themes": "^0.4.6",
    "node-pty": "^1.1.0",
    "node-schedule": "^2.1.1",
    "node-ssh": "^13.2.1",
