# Cronium Development Environment Configuration Example
# Copy this file to .env.dev and update with your actual values
# This file is for development use with docker-compose.dev.yml

# ============================================
# REQUIRED VARIABLES
# ============================================

# Build Configuration
BUILD_VERSION=latest
# NOTE: Do NOT set NODE_ENV here. Next.js manages it itself (development for
# `next dev`, production for `next build`/`next start`); forcing it via dotenv
# makes `next build` load React's development runtimes and breaks static export.
LOG_LEVEL=debug

# Database Configuration
# Note: docker-compose.dev.yml expects an external PostgreSQL database
# Provide the complete connection string
DATABASE_URL=postgresql://username:password@host:port/database_name?sslmode=disable

# Authentication & Security
AUTH_URL=http://localhost:5001
AUTH_SECRET=dev-auth-secret-min-32-chars-generate-with-openssl-rand-base64-32
ENCRYPTION_KEY=dev-32-character-hex-key-generate-with-openssl-rand-hex-32

# Internal Service Authentication
INTERNAL_API_KEY=dev-internal-api-key-min-32-chars-generate-with-openssl-rand-base64-32
JWT_SECRET=dev-jwt-secret-min-32-chars-generate-with-openssl-rand-base64-32

# Service Configuration
ORCHESTRATOR_ID=dev-orchestrator-01
MAX_CONCURRENT_JOBS=5
JOB_POLL_INTERVAL=5s

# Service Ports
APP_PORT=5001
SOCKET_PORT=5002
VALKEY_PORT=6379

# WebSocket Configuration (for client-side)
SOCKET_URL=http://localhost:5002

# Valkey/Redis Configuration
VALKEY_MAX_MEMORY=128mb

# Public App URL (for development)
PUBLIC_APP_URL=http://localhost:5001

# ============================================
# OPTIONAL VARIABLES
# ============================================

# Email Configuration (optional in dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=dev@localhost

# AI Configuration (optional in dev)
OPENAI_API_KEY=

# External Monitoring (optional in dev)
PROMETHEUS_URL=
GRAFANA_URL=

# Development-specific Configuration
SKIP_ENV_VALIDATION=
NEXT_TELEMETRY_DISABLED=1

# ============================================
# DEVELOPMENT NOTES
# ============================================
# 1. For development, you can use simpler secrets:
#    - AUTH_SECRET: openssl rand -base64 32
#    - ENCRYPTION_KEY: openssl rand -hex 32
#    - INTERNAL_API_KEY: openssl rand -base64 32
#    - JWT_SECRET: openssl rand -base64 32
#
# 2. DATABASE_URL should point to your development database
#    - Local: postgresql://dev:devpassword@localhost:5432/cronium_dev
#    - Docker: postgresql://dev:devpassword@host.docker.internal:5432/cronium_dev
#
# 3. The development compose file runs services with:
#    - Hot reloading enabled (Air for Go, Next.js dev mode)
#    - Debug logging
#    - Expanded volume mounts for development
#
# 4. To skip environment validation during development:
#    Set SKIP_ENV_VALIDATION=1
#
# 5. Email is optional in development. Leave SMTP variables empty
#    to disable email functionality
#
# 6. The orchestrator runs with Air for hot reloading
#    Changes to Go code will automatically restart the service