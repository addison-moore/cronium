# Cronium Environment Variables
# Copy this file to .env.local and update with your values

# Database
DATABASE_URL=postgresql://cronium:cronium@localhost:5432/cronium

# Authentication
AUTH_URL=http://localhost:5001
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Encryption — MUST be exactly 64 hex characters (openssl rand -hex 32).
# The app refuses to start with a wrong-length key.
ENCRYPTION_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:5001
PUBLIC_APP_URL=http://localhost:5001

# Services
ORCHESTRATOR_URL=http://localhost:8080
RUNTIME_API_URL=http://localhost:8081
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# WebSocket
SOCKET_PORT=5002

# Valkey/Redis
VALKEY_URL=valkey://localhost:6379
VALKEY_PORT=6379
VALKEY_MAX_MEMORY=512mb

# PostgreSQL
POSTGRES_USER=cronium
POSTGRES_PASSWORD=cronium
POSTGRES_DB=cronium
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# AI Integration (optional)
OPENAI_API_KEY=

# OAuth tool integrations (optional; e.g. Google Sheets)
# Register the redirect URI {AUTH_URL}/api/oauth/callback with the provider
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=

# Monitoring (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Build Configuration
# NOTE: Do NOT set NODE_ENV here. Next.js manages it itself (development for
# `next dev`, production for `next build`/`next start`); forcing it via dotenv
# makes `next build` load React's development runtimes and breaks static export.
ANALYZE=false

# Go Services
GO_ENV=development
CGO_ENABLED=0

# Timeout Configuration (in seconds)
# These control infrastructure timeouts, separate from user-configured script timeouts
CRONIUM_SETUP_TIMEOUT=300      # 5 minutes for setup (container creation, SSH connection, etc.)
CRONIUM_CLEANUP_TIMEOUT=60     # 1 minute for cleanup
CRONIUM_MAX_EXECUTION_TIMEOUT=86400  # 24 hours max for any script execution