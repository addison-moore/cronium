# Cronium Environment Variables
# Copy this file to .env.local and update with your values

# Database
DATABASE_URL=postgresql://cronium:cronium@localhost:5432/cronium

# Authentication
AUTH_URL=http://localhost:5001
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Encryption — MUST be exactly 64 hex characters (openssl rand -hex 32).
# The app refuses to start with a wrong-length key.
ENCRYPTION_KEY=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:5001
PUBLIC_APP_URL=http://localhost:5001

# Services
ORCHESTRATOR_URL=http://localhost:8080
RUNTIME_API_URL=http://localhost:8081
INTERNAL_API_KEY=your-internal-api-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production

# WebSocket
# Docker Compose binds this host port to 127.0.0.1 only.
SOCKET_PORT=5002
# Public deployments use their HTTPS app origin and proxy /api/socketio.
# NEXT_PUBLIC_SOCKET_URL=https://cronium.example.com
# Optional comma-separated exact browser origins; defaults to PUBLIC_APP_URL
# and AUTH_URL when unset.
# SOCKET_ALLOWED_ORIGINS=http://localhost:5001

# Remote SSH execution is fail-closed. Set operator-enforced only when a
# trusted external launcher gives each mutually untrusted job its own UID or
# isolated container. Do not enable this for a normal shared SSH account.
# CRONIUM_SSH_EXECUTION_ISOLATION_MODE=operator-enforced

# Scheduling worker (native or dev Docker service) — all optional. The Docker
# helper maps a loopback DATABASE_URL host to host.docker.internal automatically.
# WORKER_ID=worker-1
# WORKER_HEALTH_PORT=5003
# WORKER_DISPATCH_INTERVAL_MS=5000
# WORKER_CLAIM_INTERVAL_MS=2000
# WORKER_MAX_CONCURRENT=10
# CRONIUM_JOB_RETENTION_DAYS=30

# Valkey/Redis
VALKEY_URL=valkey://localhost:6379
VALKEY_PORT=6379
VALKEY_MAX_MEMORY=512mb

# Number of trusted reverse-proxy hops in front of the app. Controls how the
# client IP is derived from X-Forwarded-For for rate limiting and IP checks.
# 0 (default) ignores forwarding headers entirely; set to 1 when the app sits
# behind exactly one trusted TLS reverse proxy.
TRUSTED_PROXY_HOPS=0

# PostgreSQL
POSTGRES_USER=cronium
POSTGRES_PASSWORD=cronium
POSTGRES_DB=cronium
POSTGRES_PORT=5432
POSTGRES_MAX_CONNECTIONS=100

# Email (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@your-domain.com

# AI Integration (optional)
OPENAI_API_KEY=

# OAuth tool integrations (optional; e.g. Google Sheets)
# Register the redirect URI {AUTH_URL}/api/oauth/callback with the provider
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_TENANT_ID=
OAUTH_SLACK_CLIENT_ID=
OAUTH_SLACK_CLIENT_SECRET=

# Monitoring (optional)
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Build Configuration
# NOTE: Do NOT set NODE_ENV here. Next.js manages it itself (development for
# `next dev`, production for `next build`/`next start`); forcing it via dotenv
# makes `next build` load React's development runtimes and breaks static export.
ANALYZE=false

# Go Services
GO_ENV=development
CGO_ENABLED=0

# Timeout Configuration (in seconds)
# These control infrastructure timeouts, separate from user-configured script timeouts
CRONIUM_SETUP_TIMEOUT=300      # 5 minutes for setup (container creation, SSH connection, etc.)
CRONIUM_CLEANUP_TIMEOUT=60     # 1 minute for cleanup
CRONIUM_MAX_EXECUTION_TIMEOUT=86400  # 24 hours max for any script execution
