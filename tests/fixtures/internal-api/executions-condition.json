{
  "route": "POST /api/internal/executions/[executionId]/condition",
  "auth": "job-capability",
  "responses": {
    "success": {
      "status": 200,
      "body": { "success": true }
    },
    "unauthorized": {
      "status": 401,
      "body": { "error": "Missing job capability token" }
    },
    "forbidden": {
      "status": 403,
      "body": { "error": "Forbidden" }
    },
    "forbiddenScope": {
      "status": 403,
      "body": { "error": "Capability token is not valid for this job" }
    },
    "badRequest": {
      "status": 400,
      "body": { "error": "Condition must be a boolean" }
    },
    "notFound": {
      "status": 404,
      "body": { "error": "Execution not found" }
    },
    "serverError": {
      "status": 500,
      "body": { "error": "Internal server error" }
    }
  }
}
