{
  "route": "POST /api/internal/executions/[executionId]/output",
  "auth": "job-capability",
  "responses": {
    "success": {
      "status": 200,
      "body": { "success": true }
    },
    "unauthorized": {
      "status": 401,
      "body": { "error": "Missing job capability token" }
    },
    "forbidden": {
      "status": 403,
      "body": { "error": "Forbidden" }
    },
    "forbiddenScope": {
      "status": 403,
      "body": { "error": "Capability token is not valid for this job" }
    },
    "notFound": {
      "status": 404,
      "body": { "error": "Execution not found" }
    },
    "payloadTooLarge": {
      "status": 413,
      "body": { "error": "Output exceeds the 5242880-byte limit" }
    },
    "serverError": {
      "status": 500,
      "body": { "error": "Internal server error" }
    }
  }
}
